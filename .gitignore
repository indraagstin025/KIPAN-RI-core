# ============================================================
# .gitignore — SIM-KIPAN Backend (Go)
# Flattened: isi backend/ dipindah ke root, repo ini backend murni
# ============================================================

# Project Lama (Referensi development - ignore dari commit)
KIPAN_INDONESIA/
KIPAN_INDONESIA/**

# Environment files (JANGAN COMMIT .env!)
.env
.env.local
.env.*.local
.env.production
.env.staging
*.env

# Binary builds
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
vendor/

# Test coverage
coverage/
coverage.html
*.out
*.test

# Air (hot reload)
tmp/

# Security scan reports (generate ulang tiap run, jangan commit artefak statis)
results.json
results.sarif
reports/

# Uploads lokal (PII — jangan pernah commit berkas identitas)
uploads/

# Docker data local
.docker-data/
postgres_data/
redis_data/
minio_data/

# Cache & Temporary
.cache/
*.log

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# BE-008: dump transkrip sesi agent — tidak pernah di-commit
# (berisiko memuat kredensial/pesan sensitif dari terminal)
session-*.md

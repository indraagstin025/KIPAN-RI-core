# ============================================================
# SIM-KIPAN Core API - Environment Variables Template
# JANGAN commit file .env ke Git!
# Salin file ini ke .env dan isi nilainya
# ============================================================

# ------ APP ------
APP_NAME=SIM-KIPAN Core API
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
# Domain frontend yang diizinkan mengakses API (CORS)
APP_ALLOW_ORIGIN=http://localhost:5173

# ------ DATABASE (PostgreSQL / Laragon) ------
# Pilihan 1: Menggunakan variabel individual (rekomendasi Laragon/Local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kipan_core
DB_SSLMODE=disable

# Pilihan 2: Menggunakan format DATABASE_URL terpadu
# Format: postgres://[user]:[password]@[host]:[port]/[dbname]?sslmode=[disable|require]
# Contoh Laragon (tanpa password): postgres://postgres@127.0.0.1:5432/kipan_core?sslmode=disable
# Contoh Docker: postgres://kipan_admin:password@localhost:5432/sim_kipan?sslmode=disable
DATABASE_URL=postgres://postgres@127.0.0.1:5432/kipan_core?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ------ REDIS ------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------ AUTH (JWT) ------
# Generate dengan: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h

# ------ STORAGE (Cloudflare R2 / IDCloudHost IS3) ------
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# IDCloudHost IS3: https://is3.cloudhost.id
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=GANTI_DENGAN_R2_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=GANTI_DENGAN_R2_SECRET_KEY
STORAGE_BUCKET_PUBLIC=kipan-public
STORAGE_BUCKET_PRIVATE=kipan-private
STORAGE_BUCKET_UPLOADS=kipan-uploads
STORAGE_PRESIGNED_TTL=5m

# ------ KRIPTOGRAFI (WAJIB DIISI! Minimum 64 karakter hex = 32 byte) ------
# Generate dengan: openssl rand -hex 32
# PENTING: Ketiga kunci HARUS BERBEDA satu sama lain!
#
# Untuk enkripsi NIK (AES-256-GCM)
AES_MASTER_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_1

# Untuk blind index pencarian NIK (HMAC-SHA256)
BLIND_INDEX_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_2

# Untuk signature QR Code KTA (HMAC-SHA256)
KTA_SIGNING_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_3
# ============================================================
# SIM-KIPAN Core API - Environment Variables Template
# JANGAN commit file .env ke Git!
# Salin file ini ke .env dan isi nilainya
# ============================================================

# ------ APP ------
APP_NAME=SIM-KIPAN Core API
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
# Domain frontend yang diizinkan mengakses API (CORS)
# Boleh lebih dari satu, pisahkan koma: "https://a.id,https://b.id"
# (spasi di sekitar koma otomatis dirapikan). PRODUKSI: wajib domain
# eksplisit, JANGAN "*" (wildcard + credentials = rawan CSRF)
APP_ALLOW_ORIGIN=http://localhost:5173
# L-7: proxy tambahan yang dipercaya (koma, IP/CIDR). Default localhost saja.
# Isi dengan IP Caddy bila di server berbeda, mis. "10.0.0.5".
APP_TRUSTED_PROXIES=

# Base URL frontend publik untuk tautan di pesan WA/email (tanpa trailing slash).
# Dev: http://localhost:5173 · Produksi: https://<domain-frontend>
APP_PUBLIC_URL=http://localhost:5173

# #2: token rahasia untuk /internal/health (header X-Internal-Token).
# Kosong = endpoint tidak didaftarkan di produksi (fail-closed); di dev terbuka.
# Generate: openssl rand -hex 24
INTERNAL_HEALTH_TOKEN=

# ------ DATABASE (PostgreSQL / Laragon) ------
# Pilihan 1: Menggunakan variabel individual (rekomendasi Laragon/Local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kipan_core
DB_SSLMODE=disable

# Pilihan 2: Menggunakan format DATABASE_URL terpadu
# Format: postgres://[user]:[password]@[host]:[port]/[dbname]?sslmode=[disable|require]
# Contoh Laragon (tanpa password): postgres://postgres@127.0.0.1:5432/kipan_core?sslmode=disable
# Contoh Docker: postgres://kipan_admin:password@localhost:5432/sim_kipan?sslmode=disable
DATABASE_URL=postgres://postgres@127.0.0.1:5432/kipan_core?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ------ REDIS ------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------ AUTH (JWT) ------
# Generate dengan: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
# Maksimum 30m (server menolak start jika lebih; sesi panjang pakai refresh rotation)
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
# L-6: atribut cookie refresh (default aman). Longgarkan hanya bila frontend
# beda-site: Lax + Path=/ ; None wajib HTTPS (production selalu Secure).
AUTH_COOKIE_SAMESITE=Strict
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_DOMAIN=
# Base URL verifikasi KTA yang tertanam di QR (tanpa trailing slash)
KTA_VERIFY_BASE_URL=https://kipan.id

# ------ STORAGE (S3-compatible: MinIO dev / R2 / IDCloudHost IS3) ------
# Dev lokal (docker-compose): http://127.0.0.1:9000
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# IDCloudHost IS3: https://is3.cloudhost.id
# Kosongkan untuk menonaktifkan presign (fail-closed 503). Verifikasi
# dokumen saat submit dilewati HANYA di non-production (warning di log).
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=GANTI_DENGAN_R2_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=GANTI_DENGAN_R2_SECRET_KEY
STORAGE_BUCKET_PUBLIC=kipan-public
STORAGE_BUCKET_PRIVATE=kipan-private
STORAGE_BUCKET_UPLOADS=kipan-uploads
STORAGE_PRESIGNED_TTL=5m

# ------ KRIPTOGRAFI (WAJIB DIISI! Minimum 64 karakter hex = 32 byte) ------
# Generate dengan: openssl rand -hex 32
# PENTING: Ketiga kunci HARUS BERBEDA satu sama lain!
#
# Untuk enkripsi NIK (AES-256-GCM)
AES_MASTER_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_1

# Untuk blind index pencarian NIK (HMAC-SHA256)
BLIND_INDEX_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_2

# Untuk signature QR Code KTA (HMAC-SHA256)
KTA_SIGNING_KEY=GANTI_DENGAN_64_KARAKTER_HEX_UNIK_3

# Kunci KTA sebelumnya (opsional, verify-only untuk rotasi).
# Kosongkan bila tidak dipakai. Prosedur rotasi: pindahkan nilai
# KTA_SIGNING_KEY lama ke sini, lalu isi KTA_SIGNING_KEY dengan kunci baru.
# Kartu lama tetap valid, terbitan baru memakai kunci baru.
# KTA_SIGNING_KEY_PREV=

# ------ WHATSAPP GATEWAY (Fonnte) ------
# "log" = cetak pesan ke log server (HANYA dev/test — OTP bocor bila produksi).
# Produksi WAJIB "fonnte" + token; server menolak start bila masih "log".
WA_GATEWAY_PROVIDER=log
FONNTE_TOKEN_KEY=

# ------ EMAIL (SMTP) ------
# Dev Mailpit        : MAIL_HOST=127.0.0.1, MAIL_PORT=1025, tanpa auth.
# Mailtrap sandbox   : MAIL_HOST=sandbox.smtp.mailtrap.io, MAIL_PORT=2525,
#                      isi MAIL_USERNAME + MAIL_PASSWORD (tab SMTP inbox).
# Produksi WAJIB host non-lokal + username; server menolak start bila kosong.
# Kosongkan MAIL_HOST untuk mode log-only (dev; tautan/token tampil di log server).
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@kipan.id
MAIL_FROM_NAME=Sistem Informasi KIPAN

# ============================================================
# Worker Antrian Email (outbox)
# ============================================================
# Worker mengirim email status & tautan set-password secara otomatis.
# Worker kini berjalan di biner terpisah: `go run ./cmd/worker` (bukan di API).
EMAIL_WORKER_INTERVAL=10s
EMAIL_WORKER_BATCH=25
EMAIL_WORKER_MAX_ATTEMPTS=5
# Masa berlaku tautan "buat kata sandi" (anggota baru / reset admin).
SETUP_TOKEN_TTL=168h

# Zona waktu worker untuk jadwal harian (mis. deteksi kedaluwarsa masa bakti).
WORKER_TIMEZONE=Asia/Jakarta
# Jeda job materialisasi kedaluwarsa masa bakti pengurus (mis. 24h).
WORKER_EXPIRY_INTERVAL=24h